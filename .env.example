# Frontend Environment Variables Template
# Copy this file to .env and configure your values

# Vapi Voice Assistant (Fallback/Legacy)
VITE_VAPI_PUBLIC_KEY=your_vapi_public_key_here
VITE_VAPI_ASSISTANT_ID=your_vapi_assistant_id_here

# Zara AWS Bedrock Nova 2 Sonic WebSocket Endpoint
VITE_ZARA_WS_URL=wss://your-api-id.execute-api.us-east-1.amazonaws.com/prod?token=DEV_BYPASS
VITE_ZARA_HTTP_URL=https://your-lambda-url.lambda-url.us-east-1.on.aws/
