# AWS Lambda Environment Variables Configuration

# AWS Settings
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
POLLY_VOICE_ID=Tiffany

# Security & Origin Whitelist (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,*.hostinger.com,https://yourdomain.com
JWT_SECRET=your_super_secret_jwt_key_here
DEV_BYPASS=false

# n8n Automation Webhook
N8N_WEBHOOK_URL=https://n8n.smbjugaad.com/webhook/broccoli-full-lookup


